# Demoserver – nach .env kopieren, nie einchecken.
# Hauptschlüssel (eigener, nicht der des echten Servers):  openssl rand -base64 32
PAPIGATOR_SECRET_KEY=
# Passwort der Demo-Konten „alex“ und „sam“ (kommt in App Store Connect → App-Prüfung → Anmeldedaten)
DEMO_PASSWORD=
# Stunde des täglichen Zurücksetzens (Ortszeit, TZ). Vormittags in Europa schlafen Apples Prüfer meist.
# DEMO_RESET_HOUR=11
# Erlaubter Proxy davor, damit Login-Sperre und Cookies die echte Adresse sehen (Standard: private Netze)
# PAPIGATOR_TRUSTED_PROXIES=
# Optional: Sprachmodell für eigene Scans der Prüfer (braucht einen Weg vom Demo-Host dorthin)
# PAPIGATOR_LLM_URL=
# PAPIGATOR_LLM_MODEL=
# DEMO_PORT=8000
