# Copy to .env and fill in the two required values. Never commit .env.

# --- Required -------------------------------------------------------------------------------------

# Master key for stored secrets (mail password, share links). Generate once and keep a copy in your
# password manager – a restored backup needs the same key to decrypt them:
#   openssl rand -base64 32
PAPIGATOR_SECRET_KEY=

# Bootstrap token for the first-run setup: enter it in the web app under "Ersteinrichtung" (first-run
# setup) to create the first admin. It stops working as soon as a user exists. Any long random string:
#   openssl rand -hex 24
PAPIGATOR_TOKEN=

# --- Image ----------------------------------------------------------------------------------------

# Prebuilt image (GitHub Container Registry). Leave empty to build from this folder.
# PAPIGATOR_IMAGE=ghcr.io/donsebby/papigator:latest

# --- Optional -------------------------------------------------------------------------------------

# Ports on the host: web app + API, and public share pages
# PAPIGATOR_PORT=8000
# PAPIGATOR_SHARE_PORT=8001

# User/group the server runs as inside the container. Set them to the owner of ./data and ./backup
# (e.g. the user your scanner's FTP server writes as). Default 1000.
# PUID=1000
# PGID=1000

# Time zone (nightly backup time, dates)
# TZ=Europe/Berlin

# Address under which share links and upload boxes are reachable from outside (behind your reverse
# proxy). Only a starting value: Settings → Share links in the web app takes precedence.
# PAPIGATOR_PUBLIC_URL=https://papigator.example.com

# Reverse proxies whose X-Forwarded-For is trusted (default: loopback and private networks)
# PAPIGATOR_TRUSTED_PROXIES=192.0.2.10

# Interactive API docs at /docs (no login needed to read them) – off by default
# PAPIGATOR_API_DOCS=1

# AI recognition (titles, senders, dates, tags, summaries, questions) via any OpenAI-compatible API.
# Only starting values – Settings → AI recognition in the web app takes precedence.
#   Ollama on the Docker host:        http://host.docker.internal:11434/v1
#   Ollama service in this compose:   http://ollama:11434/v1
#   Ollama elsewhere in your network: http://192.0.2.10:11434/v1
#   LM Studio:                        http://192.0.2.10:1234/v1
# PAPIGATOR_LLM_URL=
# PAPIGATOR_LLM_MODEL=gemma4:e4b
# PAPIGATOR_LLM_KEY=
# PAPIGATOR_LLM_MAX_CHARS=6000

# OCR languages (tesseract codes joined with +). The image ships deu, eng and osd; other languages need
# extra tesseract-ocr-<lang> packages in the Dockerfile.
# PAPIGATOR_OCR_LANGS=deu+eng

# Scanner inbox: seconds between scans of data/inbox/<username>/
# PAPIGATOR_INBOX_POLL=10
